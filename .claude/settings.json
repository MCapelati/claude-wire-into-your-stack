{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-on-edit.cjs\"",
            "timeout": 30,
            "statusMessage": "ESLint no arquivo editado..."
          }
        ]
      }
    ]
  }
}
